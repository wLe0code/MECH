# Copia este archivo a .env y rellena los valores reales.
# NO subas .env a git (ya está en .gitignore).

# === Claude (Anthropic) ===
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-4-7

# === ElevenLabs (TTS) ===
ELEVENLABS_API_KEY=...
# Voz por defecto de MECH (narrador). Pega aquí el voice_id de tu cuenta.
ELEVENLABS_VOICE_ID=8mBRP99B2Ng2QwsJMFQl
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Modo ahorro: true = NO llama a ElevenLabs (no gasta créditos). MECH narra
# en seco (loguea el texto). Para probar el flujo sin gastar. Se puede
# togglear en vivo desde el panel (Ajustes). Déjalo en false para producción.
TTS_DRY_RUN=false

# === Google Gemini (NanoBanana — generación de imágenes) ===
GOOGLE_API_KEY=...
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# === Arduino ===
# En Raspberry Pi normalmente /dev/ttyACM0 o /dev/ttyUSB0
ARDUINO_PORT=/dev/ttyACM0
ARDUINO_BAUD=115200
# Gestos de brazos al hablar: "full" (gestos reales: saludar, señalar...),
# "subtle" (vaivén pequeño) o "off" (no se mueven). Amplitud (grados) del
# modo subtle respecto al reposo (90°).
ARM_GESTURE_MODE=full
ARM_GESTURE_AMPLITUDE=12
# true = algunos gestos también mueven las ruedas (balanceo/giro corto).
GESTURE_WHEELS=true
# Gestos MIENTRAS PROYECTA: "simple" = un solo brazo, corto y sin ruedas
# (gasta casi nada, es lo que pidió el equipo); "full" = coreografía completa.
NARRATION_GESTURE_MODE=simple
# Cuánto tarda el brazo en subir (y bajar) durante el SALUDO. Más = más lento.
ARM_WAVE_SECONDS=2.2
# Amplitud del saludo: hasta donde sube (90=reposo, 180=arriba del todo),
# cuantos grados agita arriba y cuantas veces. NO bajar de 90: el brazo
# choca con el cuerpo del robot.
ARM_WAVE_HIGH=180
ARM_WAVE_SWING=65
# Cuantas veces sube y baja el brazo EN TOTAL al saludar, contando la subida
# inicial (3 = sube, agita dos veces y baja). Minimo 2.
ARM_WAVE_REPEATS=3
# El saludo levanta los DOS brazos (el derecho agita, el izquierdo acompana).
ARM_WAVE_BOTH=true
# Segundos entre saludos a la cámara (para no saludar en bucle al mismo).
GREETING_COOLDOWN=45

# === Giro de 180° ("mira hacia afuera" / "regresa a proyectar") ===
# ⚠️ SIN ENCODERS: el giro se mide POR TIEMPO. Hay que CALIBRAR
# TURN_180_SECONDS en el robot real (Ajustes del panel lo hace en vivo):
# pulsa "MIRA HACIA AFUERA" y ajusta hasta que quede justo de espaldas.
# La media vuelta es UN SOLO tramo LATERAL (el mismo movimiento del boton
# "LATERAL" del panel) sostenido hasta que MECH queda de espaldas. NO se usa
# rotacion: con estas ruedas hacia un movimiento raro y muy corto.
# POTENCIA AL MAXIMO (100 = PWM 255): a media potencia estos motores solo
# zumban. Lo unico que hay que calibrar son los SEGUNDOS.
TURN_180_SPEED=100
TURN_180_SECONDS=4.85
# Si se da la vuelta hacia el lado contrario, ponelo en true.
TURN_180_INVERT=false
# Tramo LATERAL que precede al giro (se aparta de la mesa/pared antes de
# rotar). 0 = giro puro, sin desplazamiento lateral.
# OBSOLETAS (sep 2026): la maniobra ya no tiene un tramo de rotacion aparte.
# Se dejan para no romper .env existentes; no hacen nada.
TURN_LATERAL_SPEED=100
TURN_LATERAL_SECONDS=0.5
# Pulso inicial a potencia maxima para romper la friccion estatica
# ("zumba pero no arranca"). 0 = desactivado.
MOTOR_KICK_SECONDS=0.15
# Velocidad para volver al punto de inicio y para el balanceo de los
# gestos. Tambien a fondo; el balanceo dura muy poco para compensarlo.
RETURN_SPEED=100
GESTURE_WHEEL_SPEED=100
GESTURE_WHEEL_SECONDS=0.18

# === RoboKit RS (movimiento por bus de pines) ===
# Pines GPIO (BCM) de la Pi que van a las entradas del RoboKit.
# ROBOKIT_PIN_FWD->pin2, LEFT->pin3, RIGHT->pin4. GND comun obligatorio.
ROBOKIT_PIN_FWD=17
ROBOKIT_PIN_LEFT=27
ROBOKIT_PIN_RIGHT=22

# === STT local (faster-whisper) ===
# Modelos: tiny, base, small. En Pi 5 con 4GB: "tiny" o "base".
WHISPER_MODEL=base
WHISPER_LANGUAGE=es
# Offline: usa el modelo ya descargado sin tocar internet (no se cuelga con
# wifi mala). Default true. Ponlo en false SOLO para descargar un modelo nuevo.
WHISPER_OFFLINE=true
# Modelo para oír "oye MECH" MIENTRAS MECH narra. Vacío = el mismo de arriba
# (no descarga nada); "tiny" es más ligero pero hay que bajarlo una vez.
# Se carga aparte y limitado a pocos hilos para no entrecortar la voz.
WHISPER_INTERRUPT_MODEL=
WHISPER_INTERRUPT_THREADS=2

# === Audio ===
# Micrófono de entrada. Vacío = dispositivo por defecto del sistema.
# El mic del proyecto es el Steren MIC-9010 (receptor USB); la C930e queda
# solo para video. Pon el numero o parte del nombre del dispositivo. Listalos:
#   python -c "import sounddevice as sd; print(sd.query_devices())"
# Ejemplos: AUDIO_INPUT_DEVICE=Steren   o   AUDIO_INPUT_DEVICE=3
AUDIO_INPUT_DEVICE=
# Tasa de CAPTURA del micrófono. Debe ser una que el hardware soporte y que
# webrtcvad acepte: 8000, 16000, 32000 o 48000. Muchos mics USB baratos
# (como el Steren WXMH/MIC-9010) NO abren a 16000 y dan
# "Invalid sample rate [PaErrorCode -9997]"; en ese caso usa 48000.
# El backend resamplea internamente a 16000 para Whisper, así que podés
# poner 48000 sin perder calidad de reconocimiento.
AUDIO_SAMPLE_RATE=48000
# Silencio (segundos) antepuesto a cada respuesta de voz. Compensa el
# arranque lento de parlantes Bluetooth que se comen la primera palabra.
# Súbelo a 1.2 o 1.5 si todavía se corta el inicio.
AUDIO_LEAD_SILENCE=1.0
# Volumen (0-100) de la música de fondo bajo la narración (solo obras con
# música, ej. Malpaís). Bajo a propósito para que la voz quede por encima.
BACKGROUND_MUSIC_VOLUME=18
# Sensibilidad del VAD (0=permisivo, 3=estricto)
VAD_AGGRESSIVENESS=2
# Segundos de silencio para considerar que terminó de hablar
VAD_SILENCE_TIMEOUT=1.2
# Cuánto más fuerte que el ruido del ambiente debe sonar la voz para grabar
# (el piso de ruido se mide solo). 2.0=sensible, 2.5=normal, 4+=solo voz
# fuerte y cercana. Súbelo en lugares ruidosos (stand de la olimpiada).
VAD_ENERGY_FACTOR=2.5
# En reposo (esperando "ok MECH"), tope de duración de cada grabación.
WAKE_MAX_UTTERANCE=4.0
# Segundos máximos que el micrófono espera por voz en cada turno.
# Súbelo si el juez/usuario tarda en empezar a hablar.
AUDIO_LISTEN_MAX_SECONDS=20

# --- Control del bucle de voz por palabra clave ---
# true = al iniciar el server, MECH arranca EN REPOSO escuchando solo la
# palabra para despertar ("ok MECH"). false = arranca apagado (hay que
# prenderlo desde el panel).
VOICE_AUTOSTART=true
# Frases que despiertan a MECH (separadas por coma). Sin acentos.
# El comando principal es "ok mech"; las variantes cubren cómo suele
# transcribirlo Whisper. Además hay tolerancia a 1 letra de error.
VOICE_WAKE_PHRASES=ok mech,okay mech,okey mech,ok mek,oye mech,despierta mech,despierta,activa mech,mech despierta
# Frases que ponen a MECH en reposo (deja de responder, sigue oyendo el wake).
VOICE_SLEEP_PHRASES=para de escuchar,deja de escuchar,para de recibir,ya no escuches,duermete mech,ponte en reposo,descansa mech,modo reposo

# --- Interrumpir a MECH mientras narra ---
# Mientras presenta, MECH escucha SOLO estas frases para poder cortarlo
# ("oye MECH" en español, "hey MECH" en inglés). Todo lo demás que oiga
# mientras habla se descarta (suele ser el eco de su propio parlante).
VOICE_INTERRUPT_ENABLED=true
VOICE_INTERRUPT_PHRASES=oye mech,oiga mech,disculpa mech,perdon mech
VOICE_INTERRUPT_PHRASES_EN=hey mech,excuse me mech,sorry mech
# Tope (segundos) de cada escucha mientras narra.
# Cuánto más fuerte que el ambiente debe sonar una voz para que MECH la grabe
# MIENTRAS habla. Alto a propósito: si no, se transcribe a sí mismo sin parar
# y la Pi se satura (audio entrecortado, panel lento). Súbelo si eso pasa;
# bájalo si no te oye al interrumpirlo.
INTERRUPT_ENERGY_FACTOR=4.0
INTERRUPT_MIN_CLIP=0.35
INTERRUPT_MAX_UTTERANCE=4.0
# Silencio que da por terminada la frase mientras narra (bájalo si tarda en
# reaccionar; súbelo si corta a media frase).
INTERRUPT_SILENCE_TIMEOUT=0.6

# --- Modo inglés (opcional) ---
# MECH vive en español. El INGLÉS se activa SI Y SOLO SI se le despierta con
# "wake up MECH"; desde ahí entiende, narra y subtitula en inglés hasta que se
# duerme (al dormirse vuelve solo a español). Ponlo en false para desactivarlo.
WAKE_ENGLISH_ENABLED=true
# Frases que despiertan a MECH EN INGLÉS (incluyen cómo suele transcribirlas
# Whisper mientras todavía está escuchando en español).
VOICE_WAKE_PHRASES_EN=wake up mech,wake up,wakeup mech,wake mech,weik ap mech,gueik ap mech
# Frases de reposo cuando está en modo inglés.
VOICE_SLEEP_PHRASES_EN=stop listening,go to sleep,sleep mech,stop mech,goodbye mech

# === Proyección ===
# Subtítulos del guion abajo de la pantalla (como en el cine), haya video,
# imagen o nada. Salen en el idioma activo. Se puede apagar desde Ajustes.
SUBTITLES_ENABLED=true
# Display del proyector (X11). Para Raspberry Pi normalmente :0
PROJECTOR_DISPLAY=:0
# Ruta donde se guardan las imágenes generadas (fallback de NanoBanana)
IMAGE_OUTPUT_DIR=./generated_images
# Ruta de la biblioteca de videos pre-renderizados (Opción B).
# Cada obra: VIDEO_LIBRARY_DIR/<slug>/seg01.mp4, seg02.mp4, ...
# Ver backend/video_library.py para los slugs disponibles.
VIDEO_LIBRARY_DIR=./video_library

# === Visión (Logitech C930e + MediaPipe) ===
# Detección de usuarios: presencia, posición y distancia estimada.
# Requiere OpenCV: pip install opencv-python-headless (funciona en Python 3.13).
# Opcional para mejor alcance: mediapipe (solo Python 3.11/3.12). Ver
# backend/requirements-vision.txt.
# Todos estos (menos VISION_ENABLED y CAMERA_INDEX) se ajustan en vivo
# desde el panel (Ajustes).
VISION_ENABLED=false
VISION_CAMERA_INDEX=0
# Distancia mínima (m): MECH se detiene ahí y, sin un usuario a esa
# distancia, no proyecta (si VISION_PROJECT_GATE=true).
VISION_MIN_DISTANCE=1.2
# MECH avanza hacia el usuario hasta la distancia mínima (solo cuando no narra).
VISION_APPROACH=true
# SIN EFECTO (jul 2026): el robot ya no gira hacia el usuario; solo se
# mueve adelante/atrás. Se conserva la clave por compatibilidad.
VISION_FOLLOW=false
# Sin usuario dentro de la distancia mínima => narra pero NO proyecta.
# APAGADO por defecto: si lo activás y la cámara no te detecta cerca, MECH
# NO proyecta. Actívalo solo tras calibrar la distancia mínima.
VISION_PROJECT_GATE=false
# Velocidad máxima (0-100) de los movimientos autónomos de visión.
VISION_MAX_SPEED=100

# === Slot de MARKETING (proyeccion directa con audio) ===
# "proyecta marketing" reproduce los videos del slot promo enteros, en fila y
# CON SU PROPIO AUDIO (MECH no narra encima). No pasa por Claude.
# OJO: estas listas TAPAN los defaults del codigo si las escribis aqui.
# VOICE_MARKETING_PHRASES=proyecta marketing,pon marketing,reproduce marketing
# VOICE_MARKETING_PHRASES_EN=play marketing,show marketing
# Tope de seguridad (segundos). El fin normal lo avisa la pantalla; esto solo
# evita quedarse colgado si no hay ningun /projector abierto.
MARKETING_MAX_SECONDS=1500
